# ── Project Identity ──────────────────────────────────────────────────────────
ENVIRONMENT_PREFIX="dev"
PROJECT_PREFIX="gradtrack"
PROJECT_LOCATION="northeurope"

# ── Azure Account ─────────────────────────────────────────────────────────────
PROJECT_SUBSCRIPTION_ID="9b93ac7e-4e02-4852-90e9-3b5fab34c960"
TENANT_ID="7d20ca84-8064-4008-9ddb-bf9216c87c7b"
PROJECT_RESOURCE_GROUP="DevOps"

# ── Container Registry ────────────────────────────────────────────────────────
ACR_NAME="${ENVIRONMENT_PREFIX}${PROJECT_PREFIX}registry"

# ── Container Apps ────────────────────────────────────────────────────────────
CONTAINER_APP_NAME="${ENVIRONMENT_PREFIX}-${PROJECT_PREFIX}-api"
CONTAINER_APP_ENV_NAME="${ENVIRONMENT_PREFIX}-${PROJECT_PREFIX}-env"

# ── Key Vault ─────────────────────────────────────────────────────────────────
KEY_VAULT_NAME="gradtrack-api-kv"

# ── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_REPO="https://github.com/dev-personal-projects/graduate-system-worker"
GITHUB_BRANCH="main"

# ── Image ─────────────────────────────────────────────────────────────────────
IMAGE_NAME="gradtrack-api"
IMAGE_TAG="latest"

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_FOLDER="${LOG_FOLDER:-${HOME}/logs}"
mkdir -p "$LOG_FOLDER"
